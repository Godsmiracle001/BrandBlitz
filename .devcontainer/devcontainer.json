{
  "name": "BrandBlitz",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000, 3001, 5432, 6379, 9000],
  "portsAttributes": {
    "3000": { "label": "web (Next.js)", "onAutoForward": "notify" },
    "3001": { "label": "api (Express)", "onAutoForward": "notify" },
    "5432": { "label": "postgres", "onAutoForward": "silent" },
    "6379": { "label": "redis", "onAutoForward": "silent" },
    "9000": { "label": "minio (S3 API)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "npm install -g pnpm@10.33.0 && pnpm install && docker compose up -d postgres redis minio minio-setup",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig"
      ]
    }
  }
}
